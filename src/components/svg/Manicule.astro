---
/**
 * <Manicule> — the printer's pointing hand (☞), drawn in line: a ruffled cuff, the back of the
 * hand, a long index finger, three curled fingers and the tucked thumb. Marks "Important"
 * callouts — always next to a visible text label (the hand alone carries no meaning).
 * `direction="left"` mirrors it.
 */
interface Props {
  class?: string;
  title?: string;
  direction?: 'right' | 'left';
  size?: number | string;
}

const { class: className, title, direction = 'right', size } = Astro.props;
const dim = typeof size === 'number' ? `${size}px` : size;
---

<svg
  class:list={['manicule', direction === 'left' && 'manicule--left', className]}
  viewBox="0 0 48 24"
  style={dim ? `width:${dim}` : undefined}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  {title && <title>{title}</title>}
  <g>
    <!-- cuff -->
    <path vector-effect="non-scaling-stroke" d="M3 4.5H9.5V20.5H3ZM5.2 4.5V20.5M3 4.5C2 6.5 2 8.5 3 10.5C2 12.5 2 14.5 3 16.5C2 18 2 19.4 3 20.5" />
    <!-- back of hand, index finger, underside -->
    <path
      vector-effect="non-scaling-stroke"
      d="M9.5 6.5C12 5.4 15.6 5.2 19.4 5.8L40.4 6.1C42.4 6.2 43.6 7.1 43.6 8.4C43.6 9.6 42.4 10.6 40.4 10.6H25.2"
    />
    <!-- curled fingers -->
    <path
      vector-effect="non-scaling-stroke"
      d="M25.2 10.6C27.4 10.6 28.4 11.8 28.4 13C28.4 14.2 27.4 15.2 25.6 15.2H24.2C26.2 15.2 27.2 16.2 27.2 17.4C27.2 18.6 26.2 19.6 24.4 19.6H22.4C24 19.6 24.8 20.4 24.8 21.3C24.8 22.2 24 23 22.4 23H15C12.6 23 10.8 21.8 9.5 20"
    />
    <!-- thumb tucked along the palm -->
    <path vector-effect="non-scaling-stroke" d="M13 11.4C16.4 10.8 20.4 10.6 25.2 10.6M14.6 15.4C17.6 15.2 20.6 15.2 24.2 15.2M16.4 19.6H22.4" />
    <path vector-effect="non-scaling-stroke" d="M37.4 6.6C38.6 7.4 38.6 9.2 37.4 10" stroke-width="1" />
  </g>
</svg>

<style>
  .manicule {
    display: inline-block;
    height: auto;
    width: 2em;
    vertical-align: -0.2em;
  }
  .manicule--left {
    transform: scaleX(-1);
  }
</style>
