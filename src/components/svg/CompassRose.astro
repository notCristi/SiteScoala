const rings = [96, 93, 88.5, 84];
---

<svg
  class:list={['rose', animate && 'ink', className]}
  viewBox="0 0 200 200"
  width={dim}
  height={dim}
  fill="none"
  stroke="currentColor"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  {title && <title>{title}</title>}
  <mask id={`${uid}a`} maskUnits="userSpaceOnUse" x="0" y="0" width="200" height="200">
    <rect width="200" height="200" fill="#fff" />
    <path d={P.k0 + P.k1} fill="#000" stroke="#000" stroke-width="1.2" stroke-linejoin="round" />
  </mask>
  <mask id={`${uid}b`} maskUnits="userSpaceOnUse" x="0" y="0" width="200" height="200">
    <rect width="200" height="200" fill="#fff" />
    <path d={P.k0} fill="#000" stroke="#000" stroke-width="1.2" stroke-linejoin="round" />
  </mask>
  <g class="draw" transform="rotate(-90 100 100)">
    {rings.map((r) => <circle cx="100" cy="100" r={r} stroke-width="0.6" pathLength="1" />)}
  </g>
  <g class="set">
    <path d={P.ticks} stroke-width="0.5" />
    <path d={P.cells} fill="currentColor" stroke="none" />
    <circle cx="100" cy="100" r="30" stroke-width="0.5" stroke-dasharray="1.2 1.6" mask={`url(#${uid}a)`} />
  </g>
  <g mask={`url(#${uid}a)`}>
    <path class="draw" d={P.o2} stroke-width="0.7" pathLength="1" />
    <path class="set" d={P.f2} fill="currentColor" stroke="none" />
  </g>
  <g mask={`url(#${uid}b)`}>
    <path class="draw" d={P.o1} stroke-width="0.8" pathLength="1" />
    <path class="set" d={P.f1} fill="currentColor" stroke="none" />
  </g>
  <path class="draw" d={P.o0} stroke-width="0.9" pathLength="1" />
  <g class="set late">
    <path d={P.f0} fill="currentColor" stroke="none" />
    <path d={P.fleur} fill="currentColor" stroke="none" />
    <path d={P.cross} stroke-width="1.4" />
    <circle cx="100" cy="100" r="3.2" fill="currentColor" stroke="none" />
  </g>
</svg>

<style>
  .rose {
    display: block;
    overflow: visible;
  }
  @keyframes rose-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes rose-set {
    from {
      opacity: 0;
    }
  }
  .ink .draw,
  .ink .draw circle {
    stroke-dasharray: 1 1;
    animation: rose-draw 600ms cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .ink .set {
    animation: rose-set 320ms ease-out 360ms both;
  }
  .ink .set.late {
    animation-delay: 480ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .ink :is(.draw, .draw circle, .set) {
      animation: none;
    }
  }
</style>
