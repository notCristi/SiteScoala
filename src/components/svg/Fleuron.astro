---
/**
 * <Fleuron> — the printer's ivy leaf (hedera, ❧): a heart-shaped leaf with a cut midrib and
 * a stem that curls back on itself. Filled, one ink. Use as an end-of-article mark or at the
 * centre of a divider. Decorative by default.
 * `flip` mirrors it (the hedera was set both ways, often as a pair around a title).
 */
interface Props {
  class?: string;
  title?: string;
  flip?: boolean;
  size?: number | string;
}

const { class: className, title, flip = false, size } = Astro.props;
const dim = typeof size === 'number' ? `${size}px` : size;
---

<svg
  class:list={['fleuron', flip && 'fleuron--flip', className]}
  viewBox="0 0 48 32"
  style={dim ? `width:${dim}` : undefined}
  fill="currentColor"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  {title && <title>{title}</title>}
  <path
    fill-rule="evenodd"
    d="M18.6 15.2C16.4 9.8 18.6 4.6 24 4C28.4 3.5 30.6 6.4 32.4 9.2C35.2 13.4 38.8 16 45.6 17.6C38.6 19.2 35.4 21.6 32.4 25.8C30.4 28.6 28 31 23.6 30.2C18.4 29.2 16.6 23.8 18.8 19.2C19.2 18.2 19.3 16.6 18.6 15.2ZM21.6 17.3C26.4 17.1 31.6 17.2 37.4 17.6C31.6 17.9 26.4 18 21.6 17.9C21.3 17.8 21.3 17.4 21.6 17.3Z"
  ></path>
  <path
    d="M18.9 16.1C14.8 15.6 10.4 14.4 7.6 11.6C5.2 9.2 5 5.6 7.2 3.8C9.2 2.2 12.2 3 12.6 5.4C12.9 7.2 11.6 8.6 10 8.4C11 7.8 11.4 6.6 10.8 5.6C10 4.4 8.2 4.6 7.6 6C6.8 7.8 7.8 10 9.6 11.6C12 13.6 15.2 14.6 18.9 15.1Z"
  ></path>
</svg>

<style>
  .fleuron {
    display: inline-block;
    height: auto;
    width: 1.5em;
    vertical-align: -0.12em;
  }
  .fleuron--flip {
    transform: scaleX(-1);
  }
</style>
