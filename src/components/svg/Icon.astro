---
/**
 * <Icon name="…"> — the functional UI glyph set. Drawn for this site on a 24 × 24 grid:
 * 1.5 stroke, square caps, mitre joins, 3-unit live-area margin, one ink (currentColor).
 * Optical sizes are balanced so that a circle (clock, search) and a square (mail, calendar)
 * read the same weight side by side. Decorative by default (aria-hidden); pass `title`
 * when the icon is the only label of a control — better: label the control itself.
 *
 * These are functional glyphs only. Do not use them as decoration on cards (see the
 * anti-slop rules in CLAUDE.md); the illustrative vocabulary lives in the emblems.
 */
export type IconName =
  | 'search'
  | 'menu'
  | 'close'
  | 'arrow-right'
  | 'arrow-left'
  | 'external'
  | 'download'
  | 'file-pdf'
  | 'file-doc'
  | 'file-sheet'
  | 'phone'
  | 'mail'
  | 'map-pin'
  | 'clock'
  | 'calendar'
  | 'chevron-down'
  | 'check'
  | 'alert'
  | 'play'
  | 'language'
  | 'user'
  | 'lock'
  | 'upload'
  | 'edit'
  | 'trash'
  | 'eye'
  | 'plus'
  | 'filter'
  | 'grip';

interface Props {
  name: IconName;
  class?: string;
  title?: string;
  /** px number or CSS length; defaults to 1.5em-free sizing via CSS (24px). */
  size?: number | string;
}

const PAGE = 'M6 3H14L19 8V21H6ZM14 3V8H19';

const GLYPHS: Record<IconName, { d: string; fill?: string }> = {
  search: { d: 'M10.5 4A6.5 6.5 0 1 0 10.5 17A6.5 6.5 0 1 0 10.5 4ZM15.3 15.3L20.5 20.5' },
  menu: { d: 'M3.5 6.5H20.5M3.5 12H20.5M3.5 17.5H20.5' },
  close: { d: 'M5.5 5.5L18.5 18.5M18.5 5.5L5.5 18.5' },
  'arrow-right': { d: 'M3.5 12H19.5M13.5 6L19.5 12L13.5 18' },
  'arrow-left': { d: 'M20.5 12H4.5M10.5 6L4.5 12L10.5 18' },
  external: { d: 'M10.5 4.5H4.5V19.5H19.5V13.5M13.5 4.5H19.5V10.5M19.5 4.5L11 13' },
  download: { d: 'M12 3.5V15M6.5 9.5L12 15L17.5 9.5M4.5 20H19.5' },
  'file-pdf': { d: `${PAGE}M9.5 18.5V11H12.4A2.2 2.2 0 0 1 12.4 15.4H9.5` },
  'file-doc': { d: `${PAGE}M9 12H16M9 15H16M9 18H13.5` },
  'file-sheet': { d: `${PAGE}M9 11H16V19H9ZM9 15H16M12.5 11V19` },
  phone: {
    d: 'M8.4 3.8L10.6 8.4L8.8 10.2C9.8 12.4 11.6 14.2 13.8 15.2L15.6 13.4L20.2 15.6V19.2C20.2 19.9 19.6 20.4 18.9 20.4C10.7 19.9 4.1 13.3 3.6 5.1C3.6 4.4 4.1 3.8 4.8 3.8Z',
  },
  mail: { d: 'M3.5 5.5H20.5V18.5H3.5ZM3.5 6L12 12.5L20.5 6' },
  'map-pin': { d: 'M12 21C12 21 18.5 14.8 18.5 9.8A6.5 6.5 0 0 0 5.5 9.8C5.5 14.8 12 21 12 21ZM12 7.5A2.3 2.3 0 1 0 12 12.1A2.3 2.3 0 1 0 12 7.5Z' },
  clock: { d: 'M12 3.5A8.5 8.5 0 1 0 12 20.5A8.5 8.5 0 1 0 12 3.5ZM12 7V12L15.5 14' },
  calendar: { d: 'M4 5.5H20V20H4ZM4 9.5H20M8 3V7M16 3V7M7.5 13H10.5V16H7.5Z' },
  'chevron-down': { d: 'M6 9.5L12 15.5L18 9.5' },
  check: { d: 'M4.5 12.5L9.5 17.5L19.5 7' },
  alert: { d: 'M12 3.5L21 19.5H3ZM12 9.5V14M12 16.6V17.1' },
  play: { d: 'M7.5 4.5V19.5L19 12Z' },
  language: {
    d: 'M12 3.5A8.5 8.5 0 1 0 12 20.5A8.5 8.5 0 1 0 12 3.5ZM12 3.5C9.6 5.8 8.4 8.6 8.4 12C8.4 15.4 9.6 18.2 12 20.5C14.4 18.2 15.6 15.4 15.6 12C15.6 8.6 14.4 5.8 12 3.5ZM3.5 12H20.5M5 7.8H19M5 16.2H19',
  },
  user: { d: 'M12 4.5A3.6 3.6 0 1 0 12 11.7A3.6 3.6 0 1 0 12 4.5ZM5 20C5 16.2 8 14 12 14C16 14 19 16.2 19 20' },
  lock: { d: 'M5.5 10.5H18.5V20.5H5.5ZM8.5 10.5V7.5A3.5 3.5 0 0 1 15.5 7.5V10.5M12 14.2V16.8' },
  upload: { d: 'M12 15V3.5M6.5 9L12 3.5L17.5 9M4.5 20H19.5' },
  edit: { d: 'M15.5 4.5L19.5 8.5L9 19H5V15ZM12.8 7.2L16.8 11.2' },
  trash: { d: 'M4.5 6.5H19.5M9.5 6.5V3.5H14.5V6.5M6.5 6.5L7.5 20.5H16.5L17.5 6.5M10 10V17M14 10V17' },
  eye: {
    d: 'M2.5 12C5 7.6 8.2 5.5 12 5.5C15.8 5.5 19 7.6 21.5 12C19 16.4 15.8 18.5 12 18.5C8.2 18.5 5 16.4 2.5 12ZM12 9A3 3 0 1 0 12 15A3 3 0 1 0 12 9Z',
  },
  plus: { d: 'M12 4.5V19.5M4.5 12H19.5' },
  filter: { d: 'M3.5 5H20.5L14 12.5V19L10 20.5V12.5Z' },
  grip: { d: '', fill: 'M8 5H10V7H8ZM14 5H16V7H14ZM8 11H10V13H8ZM14 11H16V13H14ZM8 17H10V19H8ZM14 17H16V19H14Z' },
};

const { name, class: className, title, size } = Astro.props;
const g = GLYPHS[name];
const dim = typeof size === 'number' ? `${size}px` : size;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width={dim ?? '24'}
  height={dim ?? '24'}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  {title && <title>{title}</title>}
  {g.d && <path d={g.d} />}
  {g.fill && <path d={g.fill} fill="currentColor" stroke="none" />}
</svg>

<style>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: -0.2em;
  }
</style>
