<svg
  class:list={['courtyard', animate && 'ink', className]}
  viewBox="0 0 1600 260"
  preserveAspectRatio="xMidYMax slice"
  fill="none"
  stroke="currentColor"
  stroke-linecap="square"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  {title && <title>{title}</title>}
  <mask id={uid} maskUnits="userSpaceOnUse" x="0" y="0" width="1600" height="260">
    <rect width="1600" height="260" fill="#fff" />
    <path d={OCCLUDE} fill="#000" />
  </mask>
  <path class="ridge" d={RIDGE} stroke-width="0.9" mask={`url(#${uid})`} />
  <g class="plate">
    <path class="hatch" d={HATCH} stroke-width="0.8" stroke-linecap="butt" />
    <path d={DETAIL} stroke-width="1.1" />
    <path d={OUTLINE} stroke-width="1.7" />
    <path d={FILL} fill="currentColor" stroke="none" />
  </g>
</svg>

<style>
  .courtyard {
    display: block;
    width: 100%;
    height: clamp(120px, 16vw, 260px);
  }
  .ridge {
    opacity: 0.55;
  }

  @keyframes courtyard-pull {
    from {
      clip-path: inset(0 50% 0 50%);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes courtyard-ink {
    from {
      opacity: 0;
    }
  }
  .ink .plate {
    animation: courtyard-pull 600ms cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .ink .hatch,
  .ink .ridge {
    animation: courtyard-ink 400ms ease-out 450ms both;
  }
  @media (prefers-reduced-motion: reduce) {
    .ink :is(.plate, .hatch, .ridge) {
      animation: none;
    }
  }
</style>
