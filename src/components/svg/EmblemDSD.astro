---
/**
 * <EmblemDSD> — cycle emblem. Roundel with the letters DSD drawn as paths (Deutsches Sprachdiplom), double ring after the seal.
 * 64 × 64 grid, 1.5 px line (non-scaling, so the weight holds from 32 to 128 px), one ink.
 */
interface Props {
  class?: string;
  /** Accessible name; omit when the emblem sits next to a visible label (decorative). */
  title?: string;
  size?: number | string;
}

const { class: className, title, size } = Astro.props;
const dim = typeof size === 'number' ? `${size}px` : size;
---

<svg
  class:list={['emblem', className]}
  viewBox="0 0 64 64"
  width={dim}
  height={dim}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  {title && <title>{title}</title>}
  <path vector-effect="non-scaling-stroke" d="M3 32a29 29 0 1 0 58 0a29 29 0 1 0 -58 0ZM5.6 32a26.4 26.4 0 1 0 52.8 0a26.4 26.4 0 1 0 -52.8 0ZM10.5 32a21.5 21.5 0 1 0 43 0a21.5 21.5 0 1 0 -43 0ZM32 49.8L32 44.6M29.7 48.5L34.3 45.9M29.7 45.9L34.3 48.5" />
  <path vector-effect="non-scaling-stroke" stroke-width="2.25" d="M13 25H17.4C22.4 25 24.2 28.4 24.2 32C24.2 35.6 22.4 39 17.4 39H13M15.4 25V39M39.8 25H44.2C49.2 25 51 28.4 51 32C51 35.6 49.2 39 44.2 39H39.8M42.2 25V39M35.6 27.6C35 26 33.8 25 31.9 25C29.6 25 28.3 26.4 28.3 28.3C28.3 32.6 36 30.6 36 35.4C36 37.6 34.4 39 32 39C29.8 39 28.4 37.9 27.8 36.2" />
</svg>

<style>
  .emblem {
    display: inline-block;
    vertical-align: middle;
  }
</style>
