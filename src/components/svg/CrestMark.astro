  class?: string;
  /** Accessible name; omit for a decorative mark. */
  title?: string;
  variant?: 'solid' | 'line';
  /** Inner paper keyline (solid only). Defaults to true when size ≥ 40. */
  keyline?: boolean;
  /** Height in px (number) or CSS length; width follows the 104:126 aspect. */
  size?: number | string;
}

