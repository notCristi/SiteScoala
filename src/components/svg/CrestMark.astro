<svg
  class:list={['crest-mark', className]}
  viewBox="-2 -1 104 126"
  width={w}
  height={h}
  fill="none"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  {title && <title>{title}</title>}
  <circle cx="50" cy="4.6" r="2.6" stroke="currentColor" stroke-width="1.8" />
  {
    variant === 'solid' ? (
      <>
        <defs>
          <path id={`${uid}o`} d={OUTLINE} />
        </defs>
        <mask id={uid} maskUnits="userSpaceOnUse" x="-2" y="-1" width="104" height="126">
          <rect x="-2" y="-1" width="104" height="126" fill="#fff" />
          {showKey && (
            <>
              <use href={`#${uid}o`} stroke="#000" stroke-width="7.4" />
              <use href={`#${uid}o`} stroke="#fff" stroke-width="5" />
            </>
          )}
          <path d={VOLUTES} stroke="#000" stroke-width="2.4" stroke-linecap="round" />
          <path d={CHARGE} fill="#000" />
          <path d={JEWELS} fill="#fff" />
        </mask>
        <use href={`#${uid}o`} fill="currentColor" mask={`url(#${uid})`} />
      </>
    ) : (
      <>
        <path d={OUTLINE} stroke="currentColor" stroke-width="4" stroke-linejoin="round" />
        <path d={VOLUTES} stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
        <path d={CHARGE} fill="currentColor" />
      </>
    )
  }
</svg>

<style>
  .crest-mark {
    display: inline-block;
    vertical-align: middle;
    overflow: visible;
  }
</style>
