---
/** Click-to-load YouTube facade: poster from i.ytimg.com, iframe (youtube-nocookie) only after click. */
import type { Locale } from '~/i18n/locales';
import { ui } from '~/i18n/ui';
interface Props {
  id: string;
  title: string;
  locale: Locale;
}
const { id, title, locale } = Astro.props;
---

<figure class="yt">
  <div class="yt__frame plate">
    <button type="button" class="yt__btn" data-yt={id} data-title={title}>
      <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} width="480" height="360" alt="" loading="lazy" decoding="async" />
      <span class="yt__play" aria-hidden="true">
        <svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="30" fill="none" stroke="currentColor" stroke-width="1.5"></circle><circle cx="32" cy="32" r="26" fill="none" stroke="currentColor" stroke-width="1"></circle><path d="M26 21 L45 32 L26 43 Z" fill="currentColor"></path></svg>
      </span>
      <span class="vh">{ui(locale, 'playVideo')}: {title}</span>
    </button>
  </div>
  <figcaption>{title}<span class="credit">{ui(locale, 'videoConsent')}</span></figcaption>
</figure>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-yt]')) {
    b.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
      f.title = b.dataset.title ?? 'YouTube';
      f.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      f.allowFullscreen = true;
      f.className = 'yt__iframe';
      b.replaceWith(f);
      f.focus();
    }, { once: true });
  }
</script>

<style>
  .yt__frame {
    aspect-ratio: 16 / 9;
    position: relative;
  }
  .yt__btn {
    all: unset;
    cursor: pointer;
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }
  .yt__btn:focus-visible {
    outline: 3px solid var(--lapis);
    outline-offset: 3px;
  }
  .yt__btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
  }
  .yt__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--paper);
    background: rgb(11 27 77 / 0.25);
    transition: background 200ms;
  }
  .yt__play svg {
    width: 4.5rem;
    filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.4));
  }
  .yt__btn:hover .yt__play {
    background: rgb(176 18 30 / 0.35);
  }
  .yt :global(.yt__iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
