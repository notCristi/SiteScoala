---
/** Sign-in: Turnstile (managed) + lockout after 5 failures; bootstrap account while no user exists. */
import AuthShell from '~/components/admin/AuthShell.astro';
import { hasUsers, login } from '~/server/auth';
import { translator } from '~/server/admin/i18n';
import { badRequest, readForm, str } from '~/server/admin/util';
import { turnstileSiteKey } from '~/server/security';

const lang = Astro.cookies.get('hs_ui')?.value === 'de' ? 'de' : 'ro';
const t = translator(lang);
const rawNext = Astro.url.searchParams.get('next') ?? '/admin';
const next = /^\/admin(\/|$|\?)/.test(rawNext) && !rawNext.startsWith('//') ? rawNext : '/admin';
if (Astro.locals.admin && Astro.request.method === 'GET') return Astro.redirect(next, 302);

let error = '';
let email = '';
if (Astro.request.method === 'POST') {
  const fd = await readForm(Astro.request);
  if (!fd) return badRequest();
  email = str(fd.get('email'), 200);
  const res = await login(Astro, email, String(fd.get('password') ?? '').slice(0, 256), str(fd.get('cf-turnstile-response'), 2048) || null);
  if (res.ok) return Astro.redirect(res.bootstrap ? '/admin?ok=okCreated' : next, 303);
  error = { invalid: 'loginInvalid', locked: 'loginLocked', turnstile: 'loginTurnstile', config: 'loginConfig' }[res.error];
}
const bootstrap = !(await hasUsers());
---

<AuthShell title={t('login')} lang={lang} turnstile>
  <h1>{t('login')}</h1>
  <p class="sub">{t('loginTitle')}</p>
  {
    error && (
      <p class="flash flash--error" role="alert">
        {t(error)}
      </p>
    )
  }
  {bootstrap && <p class="flash">{t('bootstrapNotice')}</p>}
  <form method="post">
    <div class="f">
      <label for="email">{t('email')}</label>
      <input type="email" id="email" name="email" value={email} autocomplete="username" required autofocus />
    </div>
    <div class="f">
      <label for="password">{t('password')}</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required />
    </div>
    <div class="f">
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey()} data-action="login" data-appearance="interaction-only" data-language={lang}></div>
    </div>
    <button class="btn btn--primary" type="submit">{t('signIn')}</button>
  </form>
  <p class="help" style="margin-top: var(--s-4); text-align: center">
    <a href={`/admin/ui?l=${lang === 'de' ? 'ro' : 'de'}&next=/admin/login`}>{lang === 'de' ? 'Română' : 'Deutsch'}</a>
  </p>
</AuthShell>
