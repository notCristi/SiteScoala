---
/** Redirects (admin only): legacy URLs → new pages; hits are counted by the middleware. */
import { desc, eq, like, or } from 'drizzle-orm';
import Admin from '~/layouts/Admin.astro';
import Flash from '~/components/admin/Flash.astro';
import { db, schema as s } from '~/server/db';
import { normalizePath } from '~/server/redirects';
import { audit, can } from '~/server/admin/audit';
import { purge } from '~/server/admin/purge';
import { translator } from '~/server/admin/i18n';
import { flashFrom } from '~/server/admin/view';
import { fmtDate, str } from '~/server/admin/util';

const user = Astro.locals.admin!;
const t = translator(user.uiLocale);
if (!can(user, 'admin')) return Astro.redirect('/admin?err=errForbidden', 303);
let error = '';
let draft = { from: '', to: '', code: 301, note: '' };
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const act = str(fd.get('_action'), 20);
  const id = Number(fd.get('id')) || null;
  if (act === 'delete' && id) {
    await db().delete(s.redirects).where(eq(s.redirects.id, id));
    await audit(Astro, 'delete', 'redirects', id);
    return Astro.redirect('/admin/redirectionari?ok=okDeleted', 303);
  }
  const rawFrom = str(fd.get('from'), 500);
  const to = str(fd.get('to'), 500);
  const code = [301, 302, 307, 308].includes(Number(fd.get('code'))) ? Number(fd.get('code')) : 301;
  const note = str(fd.get('note'), 200) || null;
  draft = { from: rawFrom, to, code, note: note ?? '' };
  let from = '';
  try {
    const u = new URL(rawFrom, 'https://x.invalid');
    from = normalizePath(u.pathname, u.search);
  } catch {
    from = '';
  }
  if (!from.startsWith('/') || !/^(\/[^\s]*|https?:\/\/[^\s]+)$/.test(to)) error = 'errUrl';
  else if (normalizePath(to) === from) error = 'r_loop';
  else {
    const [clash] = await db().select().from(s.redirects).where(eq(s.redirects.fromPath, from)).limit(1);
    if (clash && clash.id !== id) error = 'errSlugTaken';
    else {
      if (id) await db().update(s.redirects).set({ fromPath: from, toPath: to, code, note }).where(eq(s.redirects.id, id));
      else await db().insert(s.redirects).values({ fromPath: from, toPath: to, code, note });
      // no chains: anything pointing at the old address now points at the final target
      await db().update(s.redirects).set({ toPath: to }).where(eq(s.redirects.toPath, from));
      await audit(Astro, id ? 'update' : 'create', 'redirects', id ?? from, `${from} → ${to}`);
      await purge(Astro, [], ['notfound']);
      return Astro.redirect('/admin/redirectionari?ok=okSaved', 303);
    }
  }
}
const q = (Astro.url.searchParams.get('q') ?? '').slice(0, 100).replace(/[%_]/g, '');
const edit = Number(Astro.url.searchParams.get('edit')) || 0;
const rows = await db()
  .select()
  .from(s.redirects)
  .where(q ? or(like(s.redirects.fromPath, `%${q}%`), like(s.redirects.toPath, `%${q}%`)) : undefined)
  .orderBy(desc(s.redirects.hits), desc(s.redirects.id))
  .limit(300);
const editing = edit ? rows.find((r) => r.id === edit) ?? (await db().select().from(s.redirects).where(eq(s.redirects.id, edit)))[0] : undefined;
if (editing && !draft.from) draft = { from: editing.fromPath, to: editing.toPath, code: editing.code, note: editing.note ?? '' };
const flash = flashFrom(Astro.url);
---

<Admin title={t('redirects')} active="redirectionari">
  <header class="adm-head"><h1>{t('redirects')}</h1></header>
  <Flash t={t} ok={flash.ok} err={error || flash.err} />
  <form method="post" class="card" style="margin-bottom: var(--s-5)">
    <h2>{editing ? t('edit') : t('r_add')}</h2>
    <input type="hidden" name="_csrf" value={user.csrf} />
    {editing && <input type="hidden" name="id" value={editing.id} />}
    <div class="grid-2">
      <div class="f"><label for="from">{t('r_from')}</label><input type="text" id="from" name="from" value={draft.from} placeholder="/lic/..." required /></div>
      <div class="f"><label for="to">{t('r_to')}</label><input type="text" id="to" name="to" value={draft.to} placeholder="/ro/..." required /></div>
      <div class="f">
        <label for="code">{t('r_code')}</label>
        <select id="code" name="code">
          {[301, 302, 307, 308].map((c) => <option value={c} selected={c === draft.code}>{c}{c === 301 ? ' (permanent)' : c === 302 ? ' (temporar)' : ''}</option>)}
        </select>
      </div>
      <div class="f"><label for="note">{t('r_note')}</label><input type="text" id="note" name="note" value={draft.note} /></div>
    </div>
    <div class="btn-row">
      <button class="btn btn--primary" name="_action" value="save">{t('save')}</button>
      {editing && <a class="btn btn--quiet" href="/admin/redirectionari">{t('cancel')}</a>}
    </div>
  </form>
  <form class="toolbar" method="get">
    <div class="f grow"><label for="q">{t('search')}</label><input type="search" id="q" name="q" value={q} data-filter-table="#redir" /></div>
    <button class="btn" type="submit">{t('search')}</button>
  </form>
  <div class="table-wrap">
    <table class="t cards" id="redir">
      <thead><tr><th>{t('r_from')}</th><th>{t('r_to')}</th><th>{t('r_code')}</th><th>{t('r_hits')}</th><th>{t('r_lastHit')}</th><th><span class="sr-only">{t('edit')}</span></th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="title"><code>{r.fromPath}</code>{r.note && <small>{r.note}</small>}</td>
            <td data-l={t('r_to')}><a href={r.toPath} target="_blank" rel="noopener">{r.toPath}</a></td>
            <td data-l={t('r_code')} class="num">{r.code}</td>
            <td data-l={t('r_hits')} class="num">{r.hits}</td>
            <td data-l={t('r_lastHit')}><time>{fmtDate(r.lastHitAt, user.uiLocale)}</time></td>
            <td>
              <form method="post" class="btn-row">
                <input type="hidden" name="_csrf" value={user.csrf} />
                <input type="hidden" name="id" value={r.id} />
                <a class="btn btn--sm" href={`?edit=${r.id}`}>{t('edit')}</a>
                <button class="btn btn--sm btn--danger" name="_action" value="delete" data-confirm={t('confirmDelete')}>{t('delete')}</button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Admin>
