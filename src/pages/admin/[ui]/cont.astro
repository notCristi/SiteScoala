---
/** My account: password change (closes other sessions), interface language. */
import Admin from '~/layouts/Admin.astro';
import Flash from '~/components/admin/Flash.astro';
import { changePassword } from '~/server/auth';
import { translator } from '~/server/admin/i18n';
import { flashFrom } from '~/server/admin/view';

const user = Astro.locals.admin!;
const t = translator(user.uiLocale);
let error = '';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const cur = String(fd.get('current') ?? '').slice(0, 300);
  const pw = String(fd.get('password') ?? '').slice(0, 300);
  if (pw !== String(fd.get('password2') ?? '').slice(0, 300)) error = 'pwMismatch';
  else {
    const problem = await changePassword(Astro, user, cur, pw);
    if (!problem) return Astro.redirect('/admin/cont?ok=pwChanged', 303);
    error = problem;
  }
}
const flash = flashFrom(Astro.url);
---

<Admin title={t('account')}>
  <header class="adm-head">
    <div>
      <span class="kicker">{user.email} · {t(`role_${user.role}`)}</span>
      <h1>{t('account')}</h1>
    </div>
  </header>
  <Flash t={t} ok={flash.ok} err={error || flash.err} />
  {user.mustChangePassword && <p class="flash flash--error">{t('changePwNotice')}</p>}
  <div class="dash">
    <form method="post" class="card">
      <h2>{t('changePassword')}</h2>
      <input type="hidden" name="_csrf" value={user.csrf} />
      <input type="hidden" name="username" value={user.email} autocomplete="username" />
      <div class="f">
        <label for="current">{t('currentPassword')}</label>
        <input type="password" id="current" name="current" required autocomplete="current-password" />
      </div>
      <div class="f">
        <label for="password">{t('newPassword')}</label>
        <input type="password" id="password" name="password" required minlength="12" autocomplete="new-password" aria-describedby="pw-hint" />
        <p class="help" id="pw-hint">{t('pwHint')}</p>
      </div>
      <div class="f">
        <label for="password2">{t('passwordRepeat')}</label>
        <input type="password" id="password2" name="password2" required minlength="12" autocomplete="new-password" />
      </div>
      <button class="btn btn--primary" type="submit">{t('changePassword')}</button>
    </form>
    <section class="card">
      <h2>{t('uiLanguage')}</h2>
      <div class="btn-row">
        <a class="btn" href="/admin/ui?l=ro&next=/admin/cont" aria-current={user.uiLocale === 'ro' ? 'true' : undefined} lang="ro">Română</a>
        <a class="btn" href="/admin/ui?l=de&next=/admin/cont" aria-current={user.uiLocale === 'de' ? 'true' : undefined} lang="de">Deutsch</a>
      </div>
    </section>
  </div>
</Admin>
