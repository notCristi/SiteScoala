---
/**
 * Public router for /ro/…, /de/…, /en/…
 * Resolves the localized path via the route table, loads layout data (settings + urgent banner)
 * in one D1 batch, and renders the matching view. Pages are edge-cached and purged by tag on publish.
 */
import { isLocale, type Locale } from '~/i18n/locales';
import { alternates as altsFor, match, type Match } from '~/i18n/routes';
import { getArticle, getGallery, getGuide, getLayoutData, getLife, getProject } from '~/server/content';
import { cacheTagsFor, edgeTtlFor } from '~/server/cache';
import { handleContact, isFormRequest, type ContactResult } from '~/server/contact';
import { url } from '~/i18n/routes';
import Home from '~/views/Home.astro';
import Editorial from '~/views/Editorial.astro';
import History from '~/views/History.astro';
import Admissions from '~/views/Admissions.astro';
import GuideView from '~/views/Guide.astro';
import Documents from '~/views/Documents.astro';
import StaffView from '~/views/Staff.astro';
import NewsList from '~/views/NewsList.astro';
import Article from '~/views/Article.astro';
import Education from '~/views/Education.astro';
import Life from '~/views/Life.astro';
import Entry from '~/views/Entry.astro';
import Projects from '~/views/Projects.astro';
import GalleryList from '~/views/GalleryList.astro';
import GalleryView from '~/views/Gallery.astro';
import Contact from '~/views/Contact.astro';
import Search from '~/views/Search.astro';
import NotFound from '~/views/NotFound.astro';

const { lang, path = '' } = Astro.params;
const locale: Locale = isLocale(lang) ? lang : 'ro';
let m: Match | undefined = isLocale(lang) ? match(locale, path) : undefined;

const layout = await getLayoutData();
let entity: unknown;
if (m) {
  const p = m.params;
  if (m.id === 'article') entity = await getArticle(p.slug ?? '');
  else if (m.id === 'project') entity = await getProject(p.slug ?? '');
  else if (m.id === 'lifeEntry') entity = await getLife(p.slug ?? '');
  else if (m.id === 'galleryItem') entity = await getGallery(p.slug ?? '');
  else if (m.id === 'guide') entity = await getGuide(p.kind as never);
  if (['article', 'project', 'lifeEntry', 'galleryItem', 'guide'].includes(m.id) && !entity) m = undefined;
}

// The contact form posts to its own page: errors come back as this page with the user's text (no JS needed).
let contactForm: ContactResult | undefined;
if (Astro.request.method === 'POST') {
  if (m?.id !== 'contact') return new Response(null, { status: 405, headers: { Allow: 'GET, HEAD', 'Cache-Control': 'no-store' } });
  if (!isFormRequest(Astro.request)) return new Response('Unsupported Media Type', { status: 415, headers: { 'Cache-Control': 'no-store' } });
  contactForm = await handleContact(Astro.request, locale);
  if (contactForm.ok) return Astro.redirect(`${url('contact', locale)}?trimis=1#formular`, 303);
  Astro.response.status = 400;
  Astro.response.headers.set('Cache-Control', 'private, no-store');
} else if (!m) {
  Astro.response.status = 404;
  Astro.cache.set({ maxAge: 300, tags: ['site', 'notfound'] });
  Astro.response.headers.set('Cache-Control', 'public, max-age=60');
} else {
  // Date-dependent pages (open/closed steps, upcoming events, expiring documents) use a short edge TTL;
  // the cron also purges them when a date boundary passes (src/server/scheduled.ts).
  Astro.cache.set({ ...edgeTtlFor(m), tags: cacheTagsFor(m) });
  // Browsers revalidate HTML on every visit (cheap 304 at the edge); the edge keeps it until purge / TTL.
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
}

const alternates = m ? altsFor(m) : { ro: '/ro/', de: '/de/', en: '/en/' };
const common = { locale, match: m!, alternates, settings: layout.settings, banners: layout.banners, entity };
const id = m?.id;
---

{!m && <NotFound locale={locale} alternates={alternates} settings={layout.settings} banners={layout.banners} />}
{id === 'home' && <Home {...common} />}
{id && ['school', 'honterus', 'campus', 'primar', 'gimnaziu', 'liceu', 'german', 'coetus', 'privacy', 'accessibility'].includes(id) && <Editorial {...common} />}
{id === 'history' && <History {...common} />}
{id === 'admissions' && <Admissions {...common} />}
{id === 'guide' && <GuideView {...common} />}
{id === 'documents' && <Documents {...common} />}
{id === 'staff' && <StaffView {...common} />}
{id === 'news' && <NewsList {...common} />}
{id === 'article' && <Article {...common} />}
{id === 'education' && <Education {...common} />}
{id === 'life' && <Life {...common} />}
{id && ['lifeEntry', 'project'].includes(id) && <Entry {...common} />}
{id === 'projects' && <Projects {...common} />}
{id === 'gallery' && <GalleryList {...common} />}
{id === 'galleryItem' && <GalleryView {...common} />}
{id === 'contact' && <Contact {...common} form={contactForm} />}
{id === 'search' && <Search {...common} />}
