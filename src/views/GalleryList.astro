---
import Base from '~/layouts/Base.astro';
import PageHead from '~/components/PageHead.astro';
import Picture from '~/components/Picture.astro';
import { pick, formatDate } from '~/i18n/locales';
import { url } from '~/i18n/routes';
import { getMediaMap, listGalleries } from '~/server/content';
import type { ViewProps } from './types';

const { locale, match, alternates, settings, banners } = Astro.props as ViewProps;
const galleries = await listGalleries();
const media = await getMediaMap(galleries.map((g) => g.coverMediaId));
const title = ({ ro: 'Galerie', de: 'Galerie', en: 'Gallery' } as const)[locale];
---

<Base locale={locale} title={title} route={match.id} alternates={alternates} settings={settings} banners={banners}>
  <PageHead locale={locale} title={title} crumbs={[{ label: ({ ro: 'Viața școlară', de: 'Schulleben', en: 'School life' } as const)[locale], route: 'life' }, { label: title }]} />
  <ul role="list" class="wrap grid">
    {
      galleries.map((g) => {
        const m = g.coverMediaId ? media.get(g.coverMediaId) : undefined;
        return (
          <li>
            <a href={url('galleryItem', locale, { slug: g.slug })} class="g">
              {m && <span class="plate"><Picture media={m} locale={locale} sizes="(min-width: 60rem) 24rem, 100vw" ratio="4 / 3" alt="" /></span>}
              <span class="g__t">{pick(g, 'title', locale).value}</span>
              {g.eventDate && <span class="g__d">{formatDate(g.eventDate, locale, 'month-year')}</span>}
            </a>
          </li>
        );
      })
    }
  </ul>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--s-6) var(--s-5);
  }
  .g {
    display: grid;
    gap: var(--s-2);
    color: var(--ink);
    text-decoration: none;
  }
  .g__t {
    font-family: var(--font-serif);
    font-size: var(--t-h3);
  }
  .g:hover .g__t {
    text-decoration: underline;
  }
  .g__d {
    color: var(--ink-2);
    font-size: var(--t-small);
  }
</style>
