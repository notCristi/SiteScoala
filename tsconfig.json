{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "worker-configuration.d.ts", "src/**/*", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "types": ["@astrojs/cloudflare/types.d.ts"],
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "paths": { "~/*": ["src/*"] }
  }
}
